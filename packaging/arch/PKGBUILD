# Maintainer: shinishiz <shinishiz@outlook.com>
# Gold Arch packaging template for hyprcanvas-shinishiz.
#
# This is intentionally NOT a final/public PKGBUILD. The project URL is known;
# Stage 8 must supply and verify the remaining source placeholders below
# against an actual immutable public source archive.

pkgname=hyprcanvas-shinishiz
pkgver=0.1.0
pkgrel=1
pkgdesc="Hyprland Canvas suite with daemon, integration helpers, and companion plugin"
arch=('x86_64')
url='https://github.com/shinishiz/hyprcanvas-shinishiz'
license=('MIT')

depends=(
  'hyprland=0.56.2'
  'python>=3.12'
  'python-yaml'
  'jq'
  'util-linux'
  'libnotify'
)

makedepends=(
  'python-build'
  'python-hatchling'
  'python-installer'
  'pixman'
  'libdrm'
)

source=("$pkgname-$pkgver.tar.gz::https://github.com/shinishiz/hyprcanvas-shinishiz/releases/download/gold-v0.1.0/hyprcanvas-shinishiz-gold-v0.1.0.tar.gz")
sha256sums=('a257e94fa56b69610e9e02a72014a81e00ed9b9b906189355d39a6eb510c2d3a')

_source_dir='hyprcanvas-shinishiz-gold-v0.1.0'

build() {
  cd "$srcdir/$_source_dir"
  python -m build --wheel --no-isolation
  make -C plugin OUT="$srcdir/hypr-canvas.so" all
}

package() {
  cd "$srcdir/$_source_dir"

  python -m installer --destdir="$pkgdir" --prefix=/usr --no-compile-bytecode dist/*.whl

  local wrapper
  for wrapper in \
    hypr-canvas-ctl \
    hypr-canvasd \
    hypr-canvas-sync-resize \
    hypr-cycle-mode \
    hypr-canvas-transition
  do
    install -Dm755 "scripts/$wrapper" "$pkgdir/usr/bin/$wrapper"
  done

  install -Dm644 packaging/systemd/hypr-canvasd.service \
    "$pkgdir/usr/lib/systemd/user/hypr-canvasd.service"
  install -Dm755 "$srcdir/hypr-canvas.so" \
    "$pkgdir/usr/lib/hyprcanvas-shinishiz/plugins/hypr-canvas.so"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/$pkgname/CREDITS.md"
  install -Dm644 THIRD_PARTY.md "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY.md"
  install -Dm644 docs/integration.md "$pkgdir/usr/share/doc/$pkgname/integration.md"
  install -Dm644 docs/release-gold-v0.1.0.md \
    "$pkgdir/usr/share/doc/$pkgname/release-gold-v0.1.0.md"
  install -Dm644 examples/hyprland-canvas.lua \
    "$pkgdir/usr/share/doc/$pkgname/hyprland-canvas.lua"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 plugin/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.plugin"
}

# provides/conflicts/replaces are intentionally omitted. No official Arch
# package collision was found for the installed Gold CLI/wrapper paths; any
# historical/AUR relationship must be verified separately before publication.
