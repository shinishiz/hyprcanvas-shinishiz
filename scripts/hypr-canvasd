#!/usr/bin/env sh
# Stable wrapper name used by the Gold systemd unit.

set -eu

backend=$(command -v canvasd 2>/dev/null || true)
if [ -n "$backend" ] && [ -x "$backend" ]; then
    exec "$backend" "$@"
fi

if [ -n "${HOME:-}" ]; then
    backend="$HOME/.local/bin/canvasd"
    if [ -x "$backend" ]; then
        exec "$backend" "$@"
    fi
fi

printf '%s\n' 'hypr-canvasd: unable to find canvasd in PATH or ~/.local/bin' >&2
exit 127
