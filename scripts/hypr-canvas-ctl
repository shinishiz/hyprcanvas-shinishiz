#!/usr/bin/env sh
# Stable wrapper name used by the Gold Hyprland integration.

set -eu

backend=$(command -v canvas-ctl 2>/dev/null || true)
if [ -n "$backend" ] && [ -x "$backend" ]; then
    exec "$backend" "$@"
fi

if [ -n "${HOME:-}" ]; then
    backend="$HOME/.local/bin/canvas-ctl"
    if [ -x "$backend" ]; then
        exec "$backend" "$@"
    fi
fi

printf '%s\n' 'hypr-canvas-ctl: unable to find canvas-ctl in PATH or ~/.local/bin' >&2
exit 127
