# Hyprland Canvas daemon systemd user service
# Install to: ~/.config/systemd/user/hypr-canvasd.service

[Unit]
Description=Hyprland Canvas daemon
PartOf=hyprland-session.target

[Service]
Type=simple
ExecStart=/home/youruser/.local/bin/hypr-canvasd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hyprland-session.target
